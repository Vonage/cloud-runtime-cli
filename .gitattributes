# Transcripts and golden files are compared byte for byte: never convert their line endings.
test/contract/testdata/** -text
test/fakeplatform/testdata/** -text
internal/**/testdata/** -text

# Files the contract harness parses as text always use LF.
test/contract/scenarios/** text eol=lf
test/contract/allowed-diffs.txt text eol=lf
test/contract/scraped.yaml text eol=lf

# Generated command pages are compared byte for byte with the command tree: always LF, even on a Windows checkout.
docs/vcr*.md text eol=lf
